# MarketLens Environment Configuration Example
# Copy this file to .env and configure values if utilizing optional external data providers.
# DO NOT COMMIT ACTUAL SECRETS OR SENSITIVE API KEYS TO SOURCE CONTROL.

# Backend & Server Settings
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=market-events
KAFKA_CONSUMER_GROUP=marketlens-surveillance

# Optional External Market Data Providers
# (By default, MarketLens utilizes Yahoo Finance and local datasets with no keys required)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
NSE_API_KEY=your_nse_feed_token_here
